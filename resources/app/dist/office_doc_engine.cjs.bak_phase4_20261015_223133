        return resolve({ ok: false, error: 'No valid Word documents found to merge' });
      }

      const destPath = this._resolveOutputPath(outputFilename || 'MergedDocument', '', '.docx');
      const payload = { files: validFiles, destPath: destPath };
      const tempJson = path.join(this.outputDir, `payload_merge_${Date.now()}.json`);
