      const script = `
import docx, json, sys, copy
from docx.shared import Pt
from docx.oxml.ns import qn

try:
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        data = json.load(f)
    files = data.get('files', [])
    dest = data.get('destPath')

    merged_doc = docx.Document()
    first_doc = True

    for file_path in files:
        try:
            src_doc = docx.Document(file_path)
            if first_doc:
                # Copy styles from first document
                for style in src_doc.styles:
                    try:
                        merged_doc.styles.add_style(style.name, style.type)
                    except: pass
                first_doc = False

            # Copy paragraphs
            for para in src_doc.paragraphs:
                new_para = merged_doc.add_paragraph()
                new_para.style = para.style
                for run in para.runs:
                    new_run = new_para.add_run(run.text)
                    new_run.font.bold = run.font.bold
                    new_run.font.italic = run.font.italic
                    new_run.font.underline = run.font.underline
                    if run.font.size:
                        new_run.font.size = run.font.size
                    if run.font.name:
                        new_run.font.name = run.font.name

            # Copy tables
            for table in src_doc.tables:
                rows = len(table.rows)
                cols = len(table.columns)
                new_table = merged_doc.add_table(rows=rows, cols=cols)
                try:
                    new_table.style = table.style
                except: pass
                for r_idx, row in enumerate(table.rows):
                    for c_idx, cell in enumerate(row.cells):
                        new_table.cell(r_idx, c_idx).text = cell.text

            # Add page break between documents (except after last)
            if file_path != files[-1]:
                merged_doc.add_page_break()

        except Exception as merge_err:
            print(json.dumps({"ok": False, "error": f"Failed to merge {file_path}: {str(merge_err)}"}))
            sys.exit(1)

    merged_doc.save(dest)
    print(json.dumps({"ok": True, "path": dest, "mergedCount": len(files)}))
except Exception as e:
    import traceback
    print(json.dumps({"ok": False, "error": str(e), "trace": traceback.format_exc()}))
