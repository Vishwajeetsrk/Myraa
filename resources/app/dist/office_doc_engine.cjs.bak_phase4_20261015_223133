  // ===========================================================================
  // SPELLING & GRAMMAR CHECK
  // ===========================================================================
  spellCheckWord({ text, language }) {
    return new Promise((resolve) => {
      const inputText = text || '';
      const lang = language || 'en';

      // Basic spelling/grammar heuristic check
      const issues = [];
      const words = inputText.split(/\s+/).filter(w => w.length > 0);

      // Common misspellings dictionary
      const commonMisspellings = {
        'teh': 'the', 'recieve': 'receive', 'wierd': 'weird', 'seperate': 'separate',
        'occured': 'occurred', 'definately': 'definitely', 'accomodate': 'accommodate',
        'embarass': 'embarrass', 'occurance': 'occurrence', 'arguement': 'argument',
        'judgement': 'judgment', 'maintainance': 'maintenance', 'millenium': 'millennium',
        'publically': 'publicly', 'refered': 'referred', 'relevent': 'relevant',
        'succesful': 'successful', 'supersede': 'supersede', 'tommorow': 'tomorrow',
        'untill': 'until', 'withhold': 'withhold', 'yeild': 'yield'
      };

      // Grammar patterns
      const grammarPatterns = [
        { pattern: /\bi\b/g, message: 'Capitalization: "I" should be uppercase', type: 'capitalization' },
        { pattern: /\s{2,}/g, message: 'Extra whitespace detected', type: 'whitespace' },
        { pattern: /[.!?,;:]\s*[a-z]/g, message: 'Sentence should start with capital letter', type: 'capitalization' },
        { pattern: /\b(an)\s+[aeiou]/gi, message: 'Article "an" before vowel sound', type: 'article' },
        { pattern: /\b(a)\s+[aeiou]/gi, message: 'Article "a" before vowel sound - consider "an"', type: 'article' },
      ];

      // Check spelling
      words.forEach((word, idx) => {
        const lower = word.toLowerCase().replace(/[^a-z]/g, '');
        if (commonMisspellings[lower]) {
          issues.push({
            type: 'spelling',
            severity: 'major',
            word: word,
            suggestion: commonMisspellings[lower],
            position: idx,
            message: `Possible misspelling: "${word}" -> "${commonMisspellings[lower]}"`
          });
        }
      });

      // Check grammar
      grammarPatterns.forEach(({ pattern, message, type }) => {
        const matches = inputText.match(pattern);
        if (matches && matches.length > 0) {
          issues.push({
            type: 'grammar',
            severity: 'minor',
            count: matches.length,
            message: message
          });
        }
      });

      // Check for repeated words
      for (let i = 0; i < words.length - 1; i++) {
        if (words[i].toLowerCase() === words[i+1].toLowerCase() && words[i].length > 2) {
          issues.push({
            type: 'repetition',
            severity: 'minor',
            word: words[i],
            message: `Repeated word: "${words[i]}"`
          });
        }
      }

      resolve({
        ok: true,
        language: lang,
        wordCount: words.length,
        issueCount: issues.length,
        issues,
        score: Math.max(0, 100 - issues.length * 5)
      });
    });
  }

