      const tempJson = path.join(this.outputDir, `payload_redesign_${Date.now()}.json`);
      fs.writeFileSync(tempJson, JSON.stringify(payload, null, 2), 'utf8');

      const script = `
import docx, json, sys, re
from docx.shared import Inches, Pt, RGBColor, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH, WD_LINE_SPACING
from docx.enum.table import WD_TABLE_ALIGNMENT, WD_ALIGN_VERTICAL
from docx.oxml.ns import qn
from docx.oxml import OxmlElement

def hex_to_rgb(h):
    h = h.lstrip('#')
    if len(h) != 6: return (0, 120, 215)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def set_cell_shading(cell, color_hex):
    shading_elm = OxmlElement('w:shd')
    shading_elm.set(qn('w:fill'), color_hex)
    shading_elm.set(qn('w:val'), 'clear')
    cell._tc.get_or_add_tcPr().append(shading_elm)

try:
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        data = json.load(f)
    source = data.get('sourcePath')
    dest = data.get('destPath')
    opts = data.get('options', {})
    accent = hex_to_rgb(opts.get('accentColor', '#0078D7'))

    doc = docx.Document(source)

    # Fix page margins
    for section in doc.sections:
        section.top_margin = Inches(1.0)
        section.bottom_margin = Inches(1.0)
        section.left_margin = Inches(1.25)
        section.right_margin = Inches(1.25)

    # Fix typography
    for style_name in ['Normal', 'Body Text']:
        try:
            style = doc.styles[style_name]
            style.font.name = 'Calibri'
            style.font.size = Pt(11)
            style.paragraph_format.space_after = Pt(6)
            style.paragraph_format.line_spacing_rule = WD_LINE_SPACING.MULTIPLE
            style.paragraph_format.line_spacing = 1.15
        except: pass

    # Fix headings
    for level in range(1, 5):
        try:
            hs = doc.styles[f'Heading {level}']
            hs.font.name = 'Calibri'
            hs.font.bold = True
            hs.font.color.rgb = RGBColor(*accent)
            sizes = {1: 20, 2: 16, 3: 13, 4: 11}
            hs.font.size = Pt(sizes.get(level, 12))
        except: pass

    # Fix tables
    for table in doc.tables:
        try:
            table.style = 'Table Grid'
        except: pass
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        for row_idx, row in enumerate(table.rows):
            for cell in row.cells:
                cell.vertical_alignment = WD_ALIGN_VERTICAL.CENTER
                for para in cell.paragraphs:
                    para.paragraph_format.space_before = Pt(2)
                    para.paragraph_format.space_after = Pt(2)
                    for run in para.runs:
                        run.font.name = 'Calibri'
                        run.font.size = Pt(10)
            if row_idx == 0:
                for cell in row.cells:
                    set_cell_shading(cell, '0078D7')
                    for para in cell.paragraphs:
                        for run in para.runs:
                            run.font.bold = True
                            run.font.color.rgb = RGBColor(255, 255, 255)

    # Fix paragraph spacing
    for para in doc.paragraphs:
        if para.style.name == 'Normal':
            para.paragraph_format.space_after = Pt(6)
            para.paragraph_format.line_spacing_rule = WD_LINE_SPACING.MULTIPLE
            para.paragraph_format.line_spacing = 1.15
            for run in para.runs:
                if not run.font.name or run.font.name == '':
                    run.font.name = 'Calibri'
                if not run.font.size:
                    run.font.size = Pt(11)

    doc.save(dest)
    print(json.dumps({"ok": True, "path": dest, "message": "Document redesigned successfully"}))
except Exception as e:
    import traceback
    print(json.dumps({"ok": False, "error": str(e), "trace": traceback.format_exc()}))
`;

      const tempScript = path.join(this.outputDir, `redesign_docx_${Date.now()}.py`);
