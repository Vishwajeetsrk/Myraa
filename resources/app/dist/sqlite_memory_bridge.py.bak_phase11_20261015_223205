    # ── COMPUTE COMMANDS (Phase 7) ───────────────────────────────────────────
    def _cp_job_row(r):
        def _j(v, d):
            try:
                return json.loads(v) if v else d
            except Exception:
                return d
        return {"id": r[0], "jobType": r[1], "route": r[2], "provider": r[3],
                "worker_id": r[4], "status": r[5], "progress": r[6],
                "spec": _j(r[7], {}), "estimate": _j(r[8], {}),
                "error": _j(r[9], {}), "artifacts": _j(r[10], []),
                "metrics": _j(r[11], {}), "transport": r[12] or "file",
                "kernelRef": r[13] or "", "createdAt": r[14], "updatedAt": r[15]}

    def _cp_worker_row(r):
        def _j(v, d):
            try:
                return json.loads(v) if v else d
            except Exception:
                return d
        return {"id": r[0], "provider": r[1], "status": r[2], "caps": _j(r[3], {}),
                "redactions": r[4], "last_seen": r[5], "updatedAt": r[6]}

    if cmd == "cp_job_save":
        p = json.loads(sys.argv[2])
        now = p.get("updatedAt") or datetime.utcnow().isoformat()
        created = p.get("createdAt") or now
        err = p.get("error") or {}
        conn.execute(
            "INSERT INTO cp_jobs (id, job_type, route, provider, worker_id, status, progress, spec_json, estimate_json, error_json, artifacts_json, metrics_json, transport, kernel_ref, created_at, updated_at) "
            "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) "
            "ON CONFLICT(id) DO UPDATE SET job_type=excluded.job_type, route=excluded.route, provider=excluded.provider, "
            "worker_id=excluded.worker_id, status=excluded.status, progress=excluded.progress, spec_json=excluded.spec_json, "
