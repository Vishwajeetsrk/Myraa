            "compute=excluded.compute, status=excluded.status, updated_at=excluded.updated_at",
            (p.get("id"), p.get("title", ""), p.get("objective", ""), p.get("audience", ""),
             p.get("sourceKind", "topic"), p.get("sourceRef", ""), p.get("sourceText", ""),
